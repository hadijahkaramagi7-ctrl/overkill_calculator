# 13. DEMO
# ============================================================

def demo():
    print("\n" + "=" * 60)
    print("ULTIMATE OVERKILL CALCULATOR v4.2.0")
    print("Because why use + when you can use 47 classes?")
    print("=" * 60 + "\n")

    calc = OverkillCalculator()

    print("--- Basic Operations ---")
    print(calc.add(2, 3))
    print(calc.sub(10, 4))
    print(calc.mul(6, 7))
    print(calc.div(100, 5))
    print(calc.pow(2, 10))
    print(calc.mod(17, 5))

    print("\n--- String Input Parsing (Chain of Responsibility) ---")
    print(calc.add("3.14", "2.86"))

    print("\n--- Error Handling ---")
    try:
        calc.div(1, 0)
    except DivisionByZeroError as e:
        print(f"Caught as expected: {e}")

    print("\n--- Undo / Redo ---")
    calc.undo()
    calc.redo()

    calc.print_history()


if __name__ == "__main__":
    demo()
